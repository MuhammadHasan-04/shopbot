ANTHROPIC_API_KEY=sk-ant-...your-group-key...
# LangSmith tracing (optional): see every agent run, tool call, latency and token count at smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=shopbot
TAVILY_API_KEY=tvly-...
# Postgres connection string, e.g. postgresql://user:pass@host:5432/db (empty = in-memory, local testing only)
DATABASE_URL=
# Password for the seller dashboard (/admin)
ADMIN_TOKEN=pick-a-long-admin-password
# Any long random text (signs website sessions)
SESSION_SECRET=pick-another-long-random-string
